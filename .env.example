# 复制本文件为 .env 后填写（.env 已被 .gitignore 忽略，不会提交）。
# 云端运行时，把同名的值填到 GitHub 仓库的 Settings → Secrets and variables → Actions。
#
# 四个渠道都是可选的：填了哪个就走哪个，可以同时填多个做双保险。
# 一个都没填时，脚本只在终端打印，不会报错。

# --- Bark（iOS，最省事：App Store 装上打开就有 key） ---
# 形如 https://api.day.app/AbCdEf123456
BARK_URL=

# --- Server酱·Turbo（推到微信；sct.ftqq.com 扫码拿 SendKey） ---
# 形如 SCTxxxxxxxxxxxxxxxxxxxx
SERVERCHAN_KEY=

# --- PushPlus（推到微信；pushplus.plus 扫码拿 token） ---
PUSHPLUS_TOKEN=

# --- 邮件（Gmail 需要「应用专用密码」，不是登录密码） ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_TO=
